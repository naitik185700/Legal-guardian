# Guardian Legal Solutions — Environment Configuration Template

# Application URL
NEXT_PUBLIC_APP_URL="https://guardianlegalsolutions.com"

# PostgreSQL Database Connection (Production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://guardian_admin:secure_password_here@localhost:5432/guardian_legal?schema=public"

# Admin Authentication Secret (Generate with: openssl rand -base64 32)
ADMIN_JWT_SECRET="guardian_legal_secure_jwt_secret_token_key_2026_xyz"

# Transactional Email Dispatcher Configuration
# Supported providers: 'resend' | 'local-fallback'
EMAIL_PROVIDER="local-fallback"
RESEND_API_KEY=""
EMAIL_FROM="Guardian Legal Solutions <contact@guardianlegalsolutions.com>"
